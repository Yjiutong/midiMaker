.skill-deps/
.workbuddy/
__pycache__/
*.py[cod]
pip-*/
.pytest_cache/
.venv/

# ---- 训练素材：绝不递交 git ----
# 拉取的外部样本（raw wav 训练/验证素材）一律忽略
/samples/
# 数据集来源/许可证清单（含外部链接，仅本地留存，不发布）
assets/virtual_singer_sources.json
# 管线中间产物（stems / midi_raw / 临时 output）忽略
/output/

# ---- 训练后结果：可递交 ----
# results/ 下的分析结果（音高线 MIDI / 特征 / 报告）默认纳入版本控制
# 如需忽略某次试验，可在 results/ 内另建 .gitignore
!/results/

# generated analysis outputs at repo root
/features.json
/notes.json
/AUDIO_NARRATIVE.md
/SECTION_SUMMARY.*
/STYLE_REPORT.md
/TIMBRE_REPORT.*
